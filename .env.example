# Copy this file to .env.local. Never commit .env.local.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=

# Optional for public repositories. Required later for private repositories and a higher rate limit.
GITHUB_TOKEN=
GITHUB_CACHE_TTL_MS=60000
GITHUB_SYNC_REPOSITORY=c-y-s-s/notion-github-agent-demo
GITHUB_ANALYSIS_REF=codex/fix-real-data-multi-links
NOTION_SYNC_PROJECT=Notion GitHub Agent
NOTION_WORK_TYPE_PROPERTY=Work Type
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Create an Incoming Webhook for a private Slack channel. Keep this URL secret.
SLACK_WEBHOOK_URL=

# Change these only if your Notion property names are different.
NOTION_TASK_PROPERTY=Task
NOTION_PROJECT_PROPERTY=Project
NOTION_STATUS_PROPERTY=Status
NOTION_DUE_DATE_PROPERTY=Due Date
NOTION_COMPLETED_AT_PROPERTY=Completed At
NOTION_GITHUB_REPOSITORY_PROPERTY=GitHub Repository
NOTION_GITHUB_LINKS_PROPERTY=GitHub Links
